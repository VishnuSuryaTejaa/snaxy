# =========================================================
# Snaxy — Environment Variables Reference
# =========================================================

# Database Configuration
# Local SQLite development (default):
DATABASE_URL="file:./dev.db"

# Production with Turso (libSQL) — optional for dev, recommended for Vercel:
# TURSO_URL="libsql://your-db-name.turso.io"
# TURSO_AUTH_TOKEN="your-turso-auth-token"

# Admin Authentication
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-to-a-strong-password"
SESSION_SECRET="generate-a-32-char-random-hex-secret"

# Merchant UPI Details (shown on checkout QR)
NEXT_PUBLIC_UPI_ID="snaxy@upi"
NEXT_PUBLIC_MERCHANT_NAME="Snaxy Store"

# Base URL (used in notifications and webhooks)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Telegram Bot Notifications (Free via @BotFather)
# 1. Create bot with @BotFather -> get token
# 2. Start your bot and message @userinfobot to get your numeric chat ID
# 3. Run: npm run telegram:setup
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_WEBHOOK_SECRET=""

# Web Push Notifications (Free VAPID)
# Generate with: npm run vapid:gen
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@snaxy.local"
